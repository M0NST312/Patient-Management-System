@page "{id:guid}"
@model ClinicSystem.Web.Pages.Billing.DetailsModel
@{
    ViewData["Title"] = $"Invoice {Model.Invoice?.InvoiceNumber}";
    ViewData["BackUrl"] = "/Billing";
}

@if (Model.Invoice is null)
{
    <div class="alert alert-warning">Invoice not found.</div>
    return;
}

<div class="row g-3">
    <div class="col-lg-8">
        <!-- Invoice Header -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-receipt me-2"></i>Invoice <span class="font-monospace">@Model.Invoice.InvoiceNumber</span></span>
                <span class="badge badge-status-@Model.Invoice.Status.ToString().ToLower() fs-6">@Model.Invoice.Status</span>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <p class="text-muted mb-0" style="font-size:.75rem;text-transform:uppercase;">Patient</p>
                        <p class="fw-semibold mb-0">
                            <a asp-page="/Patients/Details" asp-route-id="@Model.Invoice.PatientId" class="text-decoration-none">
                                @Model.Invoice.PatientName
                            </a>
                        </p>
                    </div>
                    <div class="col-sm-6">
                        <p class="text-muted mb-0" style="font-size:.75rem;text-transform:uppercase;">Issue Date</p>
                        <p class="mb-0">@Model.Invoice.CreatedAtUtc.ToLocalTime().ToString("MMMM d, yyyy")</p>
                    </div>
                </div>

                <!-- Line Items -->
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Invoice.Items)
                    {
                        <tr>
                            <td>@item.Description</td>
                            <td class="text-end">E @item.UnitPrice.ToString("F2")</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end fw-medium">E @item.Total.ToString("F2")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot style="border-top:2px solid #e2e8f0;">
                        @if (Model.Invoice.DiscountAmount > 0)
                        {
                            <tr>
                                <td colspan="3" class="text-end text-muted">Discount</td>
                                <td class="text-end text-success">–E @Model.Invoice.DiscountAmount.ToString("F2")</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="3" class="text-end fw-semibold">Total</td>
                            <td class="text-end fw-bold fs-5">E @Model.Invoice.TotalAmount.ToString("F2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Payment History -->
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-cash-coin me-2 text-success"></i>Payment History</div>
            <div class="card-body p-0">
                @if (!Model.Invoice.Payments.Any())
                {
                    <div class="empty-state py-3"><i class="bi bi-credit-card-2-front"></i>No payments recorded yet.</div>
                }
                else
                {
                    <table class="table mb-0">
                        <thead><tr><th>Date</th><th>Method</th><th class="text-end">Amount</th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.Invoice.Payments)
                        {
                            <tr>
                                <td>@p.PaidAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                                <td><span class="badge bg-light text-dark">@p.Method</span></td>
                                <td class="text-end text-success fw-medium">E @p.Amount.ToString("F2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- Add Payment -->
        @if (Model.Invoice.Status != Domain.Enums.InvoiceStatus.Paid)
        {
            <div class="card">
                <div class="card-header"><i class="bi bi-plus-circle me-2 text-primary"></i>Record Payment</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="AddPayment">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label">Amount <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">E</span>
                                    <input name="Amount" class="form-control" type="number" step="0.01" min="0.01"
                                           max="@Model.Invoice.Balance" placeholder="0.00" required />
                                </div>
                                <div class="form-text">Balance: <strong class="text-danger">E @Model.Invoice.Balance.ToString("F2")</strong></div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Payment Method <span class="text-danger">*</span></label>
                                <select name="Method" class="form-select" required>
                                    <option value="">— Select —</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Card">Card</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="Insurance">Insurance</option>
                                    <option value="Mobile Money">Mobile Money</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-check-circle me-1"></i>Record Payment
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.PaymentError))
                        {
                            <div class="alert alert-danger mt-2 mb-0 py-2">@Model.PaymentError</div>
                        }
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Summary Sidebar -->
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-calculator me-2"></i>Summary</div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal</span>
                    <span>E @(Model.Invoice.Items.Sum(i => i.Total).ToString("F2"))</span>
                </div>
                @if (Model.Invoice.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span>Discount</span>
                        <span>–E @Model.Invoice.DiscountAmount.ToString("F2")</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-2 fw-semibold">
                    <span>Total</span>
                    <span>E @Model.Invoice.TotalAmount.ToString("F2")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-2 text-success">
                    <span>Paid</span>
                    <span>E @Model.Invoice.PaidAmount.ToString("F2")</span>
                </div>
                <div class="d-flex justify-content-between fw-bold @(Model.Invoice.Balance > 0 ? "text-danger" : "text-success")">
                    <span>Balance Due</span>
                    <span class="fs-5">E @Model.Invoice.Balance.ToString("F2")</span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-lightning me-2"></i>Actions</div>
            <div class="card-body d-flex flex-column gap-2">
                @if (Model.Invoice.Status == Domain.Enums.InvoiceStatus.Unpaid && User.IsInRole("Admin"))
                {
                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this invoice?')">
                        <button class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-trash me-2"></i>Delete Invoice</button>
                    </form>
                }
                <a asp-page="/Patients/Details" asp-route-id="@Model.Invoice.PatientId" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-person me-2"></i>View Patient
                </a>
            </div>
        </div>
    </div>
</div>
