@page
@model ClinicSystem.Web.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "New User";
    ViewData["BackUrl"] = "/Admin/Users";
}

<div class="card" style="max-width:560px;">
    <div class="card-header"><i class="bi bi-person-plus me-2"></i>Create User Account</div>
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="Input.FullName" class="form-control" placeholder="Jane Doe" />
                    <span asp-validation-for="Input.FullName" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Username" class="form-label">Username <span class="text-danger">*</span></label>
                    <input asp-for="Input.Username" class="form-control" placeholder="janedoe" autocomplete="off" />
                    <span asp-validation-for="Input.Username" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" type="email" placeholder="jane@clinic.com" />
                    <span asp-validation-for="Input.Email" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Role" class="form-label">Role <span class="text-danger">*</span></label>
                    <select asp-for="Input.Role" class="form-select">
                        <option value="Admin">Admin</option>
                        <option value="Doctor">Doctor</option>
                        <option value="Receptionist" selected>Receptionist</option>
                    </select>
                    <span asp-validation-for="Input.Role" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Password" class="form-label">Password <span class="text-danger">*</span></label>
                    <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" />
                    <div class="form-text">Minimum 6 characters.</div>
                    <span asp-validation-for="Input.Password" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="invalid-feedback d-block"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create User</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
