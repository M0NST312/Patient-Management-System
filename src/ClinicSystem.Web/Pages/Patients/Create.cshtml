@page
@model ClinicSystem.Web.Pages.Patients.CreateModel
@{
    ViewData["Title"] = "New Patient";
    ViewData["BackUrl"] = "/Patients";
}

<div class="card" style="max-width:700px;">
    <div class="card-header"><i class="bi bi-person-plus me-2"></i>Patient Registration</div>
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="alert alert-danger" style="display:none;"></div>

            <h6 class="text-muted mb-3" style="text-transform:uppercase;font-size:.72rem;letter-spacing:.08em;">Personal Information</h6>
            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label asp-for="Input.FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="Input.FullName" class="form-control" placeholder="Enter full name" />
                    <span asp-validation-for="Input.FullName" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.NationalId" class="form-label">National ID <span class="text-danger">*</span></label>
                    <input asp-for="Input.NationalId" class="form-control font-monospace" placeholder="ID number" />
                    <span asp-validation-for="Input.NationalId" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.DateOfBirth" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                    <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="Input.DateOfBirth" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Gender" class="form-label">Gender <span class="text-danger">*</span></label>
                    <select asp-for="Input.Gender" asp-items="Model.GenderOptions" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.BloodType" class="form-label">Blood Type</label>
                    <select asp-for="Input.BloodType" class="form-select">
                        <option value="">— Unknown —</option>
                        @foreach (var bt in new[] { "A+","A-","B+","B-","O+","O-","AB+","AB-" })
                        { <option value="@bt">@bt</option> }
                    </select>
                </div>
            </div>

            <hr class="section-divider" />
            <h6 class="text-muted mb-3" style="text-transform:uppercase;font-size:.72rem;letter-spacing:.08em;">Address <span class="fw-normal">(optional)</span></h6>
            <div class="row g-3 mb-3">
                <div class="col-12">
                    <label asp-for="Input.AddressLine1" class="form-label">Street Address</label>
                    <input asp-for="Input.AddressLine1" class="form-control" placeholder="123 Main Street" />
                </div>
                <div class="col-12">
                    <label asp-for="Input.AddressLine2" class="form-label">Apartment / Suite (optional)</label>
                    <input asp-for="Input.AddressLine2" class="form-control" placeholder="Apt 4B" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.City" class="form-label">City</label>
                    <input asp-for="Input.City" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.State" class="form-label">State / Region</label>
                    <input asp-for="Input.State" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Input.PostalCode" class="form-label">Postal Code</label>
                    <input asp-for="Input.PostalCode" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.Country" class="form-label">Country</label>
                    <input asp-for="Input.Country" class="form-control" />
                </div>
            </div>

            <hr class="section-divider" />
            <h6 class="text-muted mb-3" style="text-transform:uppercase;font-size:.72rem;letter-spacing:.08em;">Contact Information <span class="fw-normal">(optional)</span></h6>
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Input.ContactType" class="form-label">Type</label>
                    <select asp-for="Input.ContactType" class="form-select">
                        <option value="">— None —</option>
                        <option value="Phone">Phone</option>
                        <option value="Mobile">Mobile</option>
                        <option value="Email">Email</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label asp-for="Input.ContactValue" class="form-label">Value</label>
                    <input asp-for="Input.ContactValue" class="form-control" placeholder="+1 555-000-0000" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="Input.IsEmergencyContact" class="form-check-input" type="checkbox" />
                        <label asp-for="Input.IsEmergencyContact" class="form-check-label">Emergency contact</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Register Patient</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
