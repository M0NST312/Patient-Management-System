@page "{id:guid}"
@model ClinicSystem.Web.Pages.Patients.EditModel
@{
    ViewData["Title"] = "Edit Patient";
    ViewData["BackUrl"] = $"/Patients/Details/{Model.PatientId}";
}

<div class="card" style="max-width:700px;">
    <div class="card-header"><i class="bi bi-pencil-square me-2"></i>Edit Patient</div>
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
            <input type="hidden" asp-for="PatientId" />

            <h6 class="text-muted mb-3" style="text-transform:uppercase;font-size:.72rem;letter-spacing:.08em;">Personal Information</h6>
            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label asp-for="Input.FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.NationalId" class="form-label">National ID <span class="text-danger">*</span></label>
                    <input asp-for="Input.NationalId" class="form-control font-monospace" />
                    <span asp-validation-for="Input.NationalId" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.DateOfBirth" class="form-label">Date of Birth</label>
                    <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Gender" class="form-label">Gender</label>
                    <select asp-for="Input.Gender" asp-items="Model.GenderOptions" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.BloodType" class="form-label">Blood Type</label>
                    <select asp-for="Input.BloodType" class="form-select">
                        <option value="">— Unknown —</option>
                        @foreach (var bt in new[] { "A+","A-","B+","B-","O+","O-","AB+","AB-" })
                        { <option value="@bt">@bt</option> }
                    </select>
                </div>
            </div>

            <hr class="section-divider" />
            <h6 class="text-muted mb-3" style="text-transform:uppercase;font-size:.72rem;letter-spacing:.08em;">Address</h6>
            <div class="row g-3 mb-3">
                <div class="col-12">
                    <label asp-for="Input.AddressLine1" class="form-label">Street Address</label>
                    <input asp-for="Input.AddressLine1" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Input.AddressLine2" class="form-label">Apt / Suite</label>
                    <input asp-for="Input.AddressLine2" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.City" class="form-label">City</label>
                    <input asp-for="Input.City" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.State" class="form-label">State</label>
                    <input asp-for="Input.State" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Input.PostalCode" class="form-label">Postal Code</label>
                    <input asp-for="Input.PostalCode" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.Country" class="form-label">Country</label>
                    <input asp-for="Input.Country" class="form-control" />
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
                <a asp-page="Details" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
